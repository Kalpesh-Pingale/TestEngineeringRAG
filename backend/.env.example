# Copy to .env and fill in. Never commit the filled-in file.

# --- Jira ---
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_PROJECT_KEY=ABC
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_MCP_SERVER=http://localhost:8080
JIRA_USE_MCP=false

# --- TestRail ---
TESTRAIL_BASE_URL=https://company.testrail.io
TESTRAIL_ENABLED=false
TESTRAIL_PROJECT_ID=1
TESTRAIL_SUITE_ID=1
TESTRAIL_SECTION_ID=1
TESTRAIL_USERNAME=you@example.com
# Never put a real key in this file — it is committed to git. Real values go in backend/.env
TESTRAIL_API_KEY=
TESTRAIL_MCP_SERVER=http://localhost:8090

# --- Vector database ---
VECTOR_DB=chromadb
CHROMA_DB_PATH=./chromadb

# --- Embedding model ---
# fastembed runs locally via ONNX: no server, no API key, no GPU.
# Changing EMBEDDING_MODEL invalidates every stored vector — the app will
# detect the mismatch and require a Full Sync.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_DIR=./model_cache

# --- LLM (generation) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# --- Synchronization ---
ENABLE_INCREMENTAL_SYNC=true
SYNC_INTERVAL_MINUTES=30
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of origins allowed to call this API. Must include the
# deployed frontend URL in production, or the browser blocks every request.
CORS_ORIGINS=http://localhost:3000
