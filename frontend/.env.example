# Copy to .env.local for local overrides. Never put secrets in this file.
#
# Create React App inlines every REACT_APP_* variable into the JavaScript
# bundle at build time. Anything here is PUBLIC — visible to anyone who opens
# the site. API tokens belong in backend/.env (or Vercel project settings for
# the backend), never here.

# Base URL of the FastAPI backend. Defaults to http://localhost:8000.
REACT_APP_API_URL=http://localhost:8000
